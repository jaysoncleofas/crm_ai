APP_NAME="Jayson CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8089
APP_PORT=8089

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Default: local MySQL on the host (Sequel Ace / Homebrew / etc.).
# Containers use host.docker.internal — NOT 127.0.0.1 (that points at the container).
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=root
DB_PASSWORD=
# Optional bundled Docker MySQL instead of local:
#   DB_HOST=mysql  DB_USERNAME=crm  DB_PASSWORD=secret
#   docker compose --profile docker-db up -d
DB_ROOT_PASSWORD=secret
DB_PORT_HOST=3307
REDIS_PORT_HOST=6381

# --- Redis backs cache, sessions, queues and rate limiting ------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=crm
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Sanctum SPA auth -------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:8089,127.0.0.1:8089,localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:8089

MAIL_MAILER=log
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- CRM assistant (OpenAI) -------------------------------------------------
# Off by default: enabling it sends CRM record data to OpenAI.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
# gpt-5.6-terra (balanced) | gpt-5.6-luna (cheapest) | gpt-5.6-sol (most capable)
OPENAI_MODEL=gpt-5.6-terra
# Mask emails and phone numbers before they leave the database.
AI_REDACT_PII=true
