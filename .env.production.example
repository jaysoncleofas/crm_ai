# Production environment — copy to .env on the server (never commit).
# Deploy root: /var/www/production/crm

COMPOSE_PROJECT_NAME=crm_prod
CRM_PORT=8070

APP_NAME="Jayson CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://crm.jaysoncleofas.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=crm_prod
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=crm.jaysoncleofas.com
FRONTEND_URL=https://crm.jaysoncleofas.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS="crm@jaysoncleofas.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# CRM assistant (Gemini via Vertex AI)
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=gemini
GEMINI_SERVICE_ACCOUNT_CREDENTIALS=gemini_credentials.json
VERTEX_AI_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-2.5-flash
AI_REDACT_PII=true
